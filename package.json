{
  "name": "brambles",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:psych-scale": "node scripts/validate-psych-scale.mjs",
    "validate:ingredients": "node scripts/validate-ingredients.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "build": "npm run typecheck && npm run validate:psych-scale && npm run validate:ingredients && npm run validate:links && esbuild src/*.ts --bundle --minify --format=esm --outdir=static/js",
    "watch": "esbuild src/*.ts --bundle --format=esm --outdir=static/js --watch",
    "watch:typecheck": "tsc --noEmit --watch --preserveWatchOutput",
    "dev": "npm-run-all --parallel watch watch:typecheck dev:hugo",
    "dev:hugo": "hugo server -D"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  }
}
