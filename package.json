{
  "name": "brambles",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/*.ts --bundle --minify --format=esm --outdir=static/js",
    "watch": "esbuild src/*.ts --bundle --format=esm --outdir=static/js --watch",
    "watch:typecheck": "tsc --noEmit --watch",
    "dev": "npm-run-all --parallel watch watch:typecheck dev:hugo",
    "dev:hugo": "hugo server -D"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0"
  }
}
